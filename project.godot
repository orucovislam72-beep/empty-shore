; Engine configuration file.
; Пустой Берег / Empty Shore

config_version=5

[application]

config/name="Пустой Берег"
config/description="Мобильная игра о выживании и строительстве баз."
config/version="0.0.1"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/app_icon.svg"
boot_splash/bg_color=Color(0.07, 0.08, 0.09, 1)
run/low_processor_mode=false

[autoload]

Events="*res://scripts/core/events.gd"
Settings="*res://scripts/core/settings.gd"
SaveGame="*res://scripts/core/save_game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://assets/ui_theme.tres"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":67), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
reload={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69), Object(InputEventJoypadButton,"device":-1,"button_index":3)]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306), Object(InputEventJoypadButton,"device":-1,"button_index":4)]
}
build={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":66), Object(InputEventJoypadButton,"device":-1,"button_index":10)]
}
toggle_autorun={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81), Object(InputEventJoypadButton,"device":-1,"button_index":7)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
toggle_debug={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194334)]
}


[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.ru.translation")
locale/fallback="ru"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.66, 0.74, 1)
